{
  "private": true,
  "name": "purestack-repo",
  "version": "1.1.0",
  "packageManager": "yarn@4.9.2",
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PureStackStudio/PureStack.git"
  },
  "homepage": "https://purestack.studio",
  "bugs": {
    "url": "https://github.com/PureStackStudio/PureStack/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "esbuild": "^0.28.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "files": [],
  "scripts": {
    "purestack": "yarn tsx packages/purestack/src/cli.ts",
    "dev": "yarn tsx --watch packages/ts-ssg/src/cli.ts serve --content packages/ts-ssg/sample-content",
    "frontend": "yarn tsx --watch frontend/studio.ts serve",
    "frontend:build": "yarn tsx frontend/studio.ts build",
    "frontend:publish": "yarn tsx frontend/studio.ts publish",
    "embed": "yarn tsx scripts/embed.ts && yarn format",
    "regor-components": "yarn tsx scripts/regor-components.ts",
    "gen-icons": "yarn tsx scripts/generate-icons.ts",
    "build": "echo 'Building...' && yarn workspaces foreach --no-private --all --verbose --topological -- run build",
    "lint": "yarn workspaces foreach --no-private --all --verbose --topological -- run lint && yarn lint-puregate",
    "check-eol": "node scripts/check-eol.js",
    "sync-purestack-version": "yarn tsx --no-warnings scripts/sync-purestack-version.ts",
    "bundle": "yarn tsx --no-warnings scripts/bundle.ts",
    "cleanup": "yarn tsx --no-warnings scripts/cleanup.ts",
    "publish-new-packages": "yarn tsx --no-warnings scripts/publish-new-packages.ts",
    "test": "vitest",
    "package": "yarn workspaces foreach --no-private --all --parallel pack",
    "pack-vscode-ext": "yarn --cwd packages/ts-ssg-vscode build && yarn --cwd packages/ts-ssg-vscode package",
    "longest": "yarn tsx ./scripts/longest-functions.ts",
    "format": "biome format --write",
    "pre-commit": "yarn check-eol && yarn sync-purestack-version && yarn regor-components && yarn embed && yarn format && yarn lint && yarn build && yarn test run",
    "puregate": "yarn tsx --watch packages/ts-ssg/src/cli.ts serve --content PureGate/PureGateApp/admin-panel",
    "puregate.frontend": "yarn tsx --watch packages/ts-ssg/src/cli.ts serve --content PureGate/PureGateApp/admin-frontend",
    "puregate:publish": "yarn puregate:publish:web && yarn puregate:publish:app",
    "puregate:publish:web": "yarn tsx packages/ts-ssg/src/cli.ts publish --content PureGate/PureGateApp/admin-panel",
    "puregate:publish:frontend": "yarn tsx packages/ts-ssg/src/cli.ts publish --content PureGate/PureGateApp/admin-frontend",
    "puregate:publish:app": "powershell -ExecutionPolicy Bypass -Command \"Set-Location './PureGate'; ./scripts/package-bootstrap.ps1\"",
    "puregate:deploy:web": "pgdeploy deploy --host https://admin.puregate.dev --package ./PureGate/PureGateApp/.puregate/content/puregate.local/web --allow-path 'pagefind/*,.ts-ssg/manifest.json'",
    "puregate:deploy:frontend": "pgdeploy deploy --host https://puregate.dev --package ./PureGate/PureGateApp/.puregate/content/puregate.dev/web --allow-path 'pagefind/*,.ts-ssg/manifest.json'",
    "serve:zonetree": "yarn tsx --watch packages/ts-ssg/src/cli.ts serve --content PureGate/PureGateApp/zonetree-dev --port 4500",
    "publish:zonetree": "yarn tsx packages/ts-ssg/src/cli.ts publish --content PureGate/PureGateApp/zonetree-dev",
    "deploy:zonetree": "pgdeploy deploy --host https://zonetree.dev --package ./PureGate/PureGateApp/.puregate/content/zonetree.dev/web --allow-path 'pagefind/*,.ts-ssg/manifest.json'",
    "serve:tenray": "yarn tsx --watch packages/ts-ssg/src/cli.ts serve --content PureGate/PureGateApp/tenray-dev --port 4600",
    "publish:tenray": "yarn tsx packages/ts-ssg/src/cli.ts publish --content PureGate/PureGateApp/tenray-dev",
    "deploy:tenray": "pgdeploy deploy --host https://tenray.dev --package ./PureGate/PureGateApp/.puregate/content/tenray.dev/web --allow-path 'pagefind/*,.ts-ssg/manifest.json'",
    "puregate:deploy:app": "pgdeploy artifact deploy --host https://admin.puregate.dev --artifact system/puregate --package PureGate/artifacts/bootstrap/work/package/release --apply true --allow-path='admin-panel/.ts-ssg/manifest.json,admin-panel/pagefind*' --allow-path='release-id,watchdog/puregate,deploy/pgdeploy,app/PureGateApp,app/*.so,app/*.so.dbg,app/*.pdb,app/*.staticwebassets.*,manifest.json'",
    "lint-puregate": "biome check PureGate/PureGateApp/admin-panel --write --formatter-enabled=false",
    "format-puregate": "biome format PureGate/PureGateApp/admin-panel --write"
  }
}
