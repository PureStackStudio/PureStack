{
  "private": true,
  "name": "purestack-repo",
  "version": "1.0.0",
  "packageManager": "yarn@4.9.2",
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^25.3.0",
    "esbuild": "^0.27.3",
    "tsdown": "^0.20.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "files": [],
  "scripts": {
    "dev-css": "yarn tsx --watch packages/ts-css-bootstrap/src/index.ts",
    "dev": "yarn tsx --watch packages/ts-ssg/src/index.ts",
    "embed": "yarn tsx scripts/embed.ts && yarn format",
    "build": "yarn workspaces foreach --no-private --all --verbose --topological -- run build",
    "lint": "yarn workspaces foreach --no-private --all --verbose --topological -- run lint && yarn lint-mygate",
    "bundle": "yarn tsx --no-warnings scripts/bundle.ts && biome check --write \"packages/**/*.d.ts\"",
    "cleanup": "yarn tsx --no-warnings scripts/cleanup.ts",
    "test": "vitest",
    "package": "yarn workspaces foreach --no-private --all --parallel pack",
    "longest": "yarn tsx ./scripts/longest-functions.ts",
    "format": "biome format --write",
    "pre-commit": "yarn embed && yarn lint && yarn build && yarn test run",
    "mygate": "yarn tsx --watch packages/ts-ssg/src/index.ts --content MyGate/MyGateApp/admin-panel/content --serve",
    "lint-mygate": "biome check MyGate/MyGateApp/admin-panel/content --write --formatter-enabled=false",
    "format-mygate": "biome format MyGate/MyGateApp/admin-panel/content --write"
  }
}
