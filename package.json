{
  "private": true,
  "name": "purestack-repo",
  "version": "1.0.0",
  "packageManager": "yarn@4.9.2",
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.1",
    "@types/css.escape": "^1.5.2",
    "@types/node": "^25.1.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tsdoc": "^0.5.0",
    "tsdown": "^0.20.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "files": [],
  "scripts": {
    "dev-css": "yarn tsx --watch packages/ts-css-bootstrap/src/index.ts",
    "dev": "yarn tsx --watch packages/ts-ssg/src/index.ts",
    "build": "yarn workspaces foreach --no-private --all --verbose --topological -- run build",
    "lint": "yarn workspaces foreach --no-private --all --verbose --topological -- run lint",
    "bundle": "yarn tsx --no-warnings scripts/bundle.ts && eslint 'packages/**/*.d.ts' --fix",
    "cleanup": "yarn tsx --no-warnings scripts/cleanup.ts",
    "test": "vitest",
    "package": "yarn workspaces foreach --no-private --all --parallel pack"
  }
}
