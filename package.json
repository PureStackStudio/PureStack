{
  "private": true,
  "name": "purestack-repo",
  "version": "1.0.0",
  "packageManager": "yarn@4.9.2",
  "type": "module",
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.6.2",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "esbuild": "^0.28.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.21.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "files": [],
  "scripts": {
    "dev": "yarn tsx --watch packages/ts-ssg/src/cli.ts --content packages/ts-ssg/sample-content",
    "embed": "yarn tsx scripts/embed.ts && yarn format",
    "regor-components": "yarn tsx scripts/regor-components.ts",
    "gen-icons": "yarn tsx scripts/generate-icons.ts",
    "build": "echo 'Building...' && yarn workspaces foreach --no-private --all --verbose --topological -- run build",
    "lint": "yarn workspaces foreach --no-private --all --verbose --topological -- run lint && yarn lint-puregate",
    "bundle": "yarn tsx --no-warnings scripts/bundle.ts",
    "cleanup": "yarn tsx --no-warnings scripts/cleanup.ts",
    "test": "vitest",
    "package": "yarn workspaces foreach --no-private --all --parallel pack",
    "pack-vscode-ext": "yarn --cwd packages/ts-ssg-vscode build && yarn --cwd packages/ts-ssg-vscode package",
    "longest": "yarn tsx ./scripts/longest-functions.ts",
    "format": "biome format --write",
    "pre-commit": "yarn regor-components && yarn embed && yarn format && yarn lint && yarn build && yarn test run",
    "puregate": "yarn tsx --watch packages/ts-ssg/src/cli.ts --content PureGate/PureGateApp/admin-panel --serve",
    "puregate:publish": "yarn puregate:publish:web && yarn puregate:publish:app",
    "puregate:publish:web": "yarn tsx packages/ts-ssg/src/cli.ts --content PureGate/PureGateApp/admin-panel --clean --publish",
    "puregate:publish:app": "powershell -ExecutionPolicy Bypass -Command \"Set-Location './PureGate'; ./scripts/package-bootstrap.ps1\"",
    "puregate:deploy:web": "pgdeploy deploy --host https://koculu77.dev --package ./PureGate/PureGateApp/.puregate/content/puregate.com/web --allow-path 'pagefind/*,.ts-ssg/manifest.json'",
    "puregate:deploy:web2": "pgdeploy deploy --host https://mail.koculu77.dev --package ./PureGate/PureGateApp/.puregate/content/puregate.com/web --allow-path 'pagefind/*,.ts-ssg/manifest.json'",
    "puregate:deploy:web3": "pgdeploy deploy --host https://test.com --package ./PureGate/PureGateApp/.puregate/content/puregate.com/web --allow-path 'pagefind/*,.ts-ssg/manifest.json'",
    "puregate:deploy:app": "pgdeploy artifact deploy --host https://koculu77.dev --artifact system/puregate --package PureGate/artifacts/bootstrap/work/package/release --apply true --allow-path='admin-panel/.ts-ssg/manifest.json,admin-panel/pagefind*' --allow-path='release-id,watchdog/puregate,deploy/pgdeploy,app/PureGateApp,app/*.so,app/*.pdb,app/*.staticwebassets.*,manifest.json'",
    "lint-puregate": "biome check PureGate/PureGateApp/admin-panel --write --formatter-enabled=false",
    "format-puregate": "biome format PureGate/PureGateApp/admin-panel --write"
  }
}
