{
  "$schema": "../../packages/ts-ssg/schema/siteConfig.schema.json",
  "siteTitle": "PureStack Studio",
  "favicon": "tabler:device-desktop-analytics",
  "style": {
    "fileName": "site.css",
    "href": "/assets/site.css",
    "themes": ["light", "dark"],
    "pretty": false,
    "theme": {
      "skin": "standard",
      "presets": ["red"]
    }
  },
  "auth": {
    "enabled": false,
    "signUp": false
  },
  "html": {
    "minify": true
  },
  "scripts": {
    "cacheBusting": true
  },
  "navigation": {
    "mode": "auto",
    "navFileName": "_nav.json",
    "maxDepth": 20,
    "includeIndex": true,
    "sortBy": "order"
  },
  "sitemap": {
    "enabled": true,
    "baseUrl": "https://purestack.studio",
    "fileName": "sitemap.xml",
    "robots": {
      "enabled": true,
      "fileName": "robots.txt",
      "userAgent": "*",
      "allow": ["/"],
      "disallow": [],
      "crawlDelay": 2,
      "host": "purestack.studio",
      "additionalSitemaps": [],
      "customDirectives": ["# Generated by PureStack"]
    }
  },
  "consent": {
    "enabled": true,
    "policyVersion": "2023-02-17",
    "categories": [
      {
        "id": "necessary",
        "label": "Necessary",
        "required": true
      }
    ],
    "services": []
  },
  "analytics": {
    "ga4": {
      "enabled": false
    }
  },
  "pagefind": {
    "enabled": false,
    "excludePaths": []
  },
  "preview": {
    "title": "PureStack Studio",
    "description": "Pure frontend infrastructure for the AI age.",
    "image": "/assets/pure-stack-logo.png",
    "imageAlt": "PureStack logo",
    "imageWidth": 800,
    "imageHeight": 800,
    "siteName": "PureStack Studio",
    "twitterCard": "summary_large_image"
  },
  "logo": {
    "brand": "PureStack",
    "subtitle": "AI-Native Frontend",
    "letterColors": "111122",
    "subtitleLetterColors": "0",
    "colors": [
      "var(--ps-current-text-subtle)",
      "var(--ps-current-text-default)",
      "var(--ps-semantic-tone-accent-button-rest-background)",
      "#fdfdfd"
    ],
    "logoBackground": 2,
    "logoForeground": 3,
    "icon": "tabler:device-desktop-analytics"
  },
  "mdx": {
    "highlighter": "shiki"
  },
  "outDir": "../out/purestack.studio/web-dev",
  "publishDir": "../out/purestack.studio/web"
}
