{
  "name": "purestack-component-navigation",
  "displayName": "PureStack Component Tools",
  "description": "Component navigation, prop IntelliSense, lit-html syntax highlighting, and template formatting for Markdown, MDX, and TypeScript templates.",
  "version": "1.0.0",
  "private": true,
  "publisher": "purestack-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koculu/purestack.git",
    "directory": "packages/ts-ssg-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:mdx",
    "onLanguage:typescript"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p . --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --outfile=dist/extension.js --external:vscode",
    "watch": "tsc -p . --watch",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "prettier": "^3.8.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "purestackComponentTools.formatHtmlTemplates",
        "title": "PureStack: Format HTML Templates"
      },
      {
        "command": "purestackComponentTools.formatDocumentWithHtmlTemplates",
        "title": "PureStack: Format Document With HTML Templates"
      }
    ],
    "languages": [
      {
        "id": "mdx",
        "extensions": [
          ".mdx"
        ]
      }
    ],
    "grammars": [
      {
        "injectTo": [
          "source.ts",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html",
        "path": "./syntaxes/lit-html.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css",
          "source.css": "css"
        }
      },
      {
        "injectTo": [
          "source.ts",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html.string.injection",
        "path": "./syntaxes/lit-html-string-injection.json",
        "embeddedLanguages": {
          "meta.template.expression.ts": "typescript"
        }
      },
      {
        "injectTo": [
          "source.ts",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html.interpolation.injection",
        "path": "./syntaxes/lit-html-interpolation-injection.json",
        "embeddedLanguages": {
          "meta.embedded.expression.ts": "typescript"
        }
      },
      {
        "injectTo": [
          "source.ts",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html.style.injection",
        "path": "./syntaxes/lit-html-style-injection.json",
        "embeddedLanguages": {
          "meta.template.expression.ts": "typescript"
        }
      },
      {
        "injectTo": [
          "source.ts",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html-svg",
        "path": "./syntaxes/lit-html-svg.json",
        "embeddedLanguages": {
          "meta.embedded.block.svg": "xml"
        }
      }
    ]
  }
}
