{
  "name": "purestack-component-navigation",
  "displayName": "PureStack Component Tools",
  "description": "Component navigation, prop IntelliSense, lit-html syntax highlighting, and template formatting for Markdown, Regor MDX, and TypeScript templates.",
  "version": "1.0.0",
  "private": true,
  "publisher": "purestack-local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PureStackStudio/PureStack.git",
    "directory": "packages/ts-ssg-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:typescript"
  ],
  "main": "./dist/extension.js",
  "icon": "assets/pure-stack-logo.png",
  "scripts": {
    "build": "tsc -p . --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --minify --outfile=dist/extension.js --external:vscode --external:typescript",
    "watch": "tsc -p . --watch",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "prettier": "^3.8.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "purestackComponentTools.formatHtmlTemplates",
        "title": "PureStack: Format HTML Templates"
      },
      {
        "command": "purestackComponentTools.formatDocumentWithHtmlTemplates",
        "title": "PureStack: Format Document With HTML Templates"
      }
    ],
    "languages": [
      {
        "id": "mdx",
        "aliases": [
          "MDX",
          "Regor MDX",
          "RMDX"
        ],
        "extensions": [
          ".mdx",
          ".rmdx"
        ],
        "scopeName": "source.mdx",
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./assets/file-icon.svg",
          "light": "./assets/file-icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mdx",
        "scopeName": "source.mdx",
        "path": "./syntaxes/source.mdx.tmLanguage"
      },
      {
        "injectTo": [
          "text.html.markdown"
        ],
        "scopeName": "source.markdown.mdx.codeblock",
        "path": "./syntaxes/mdx.markdown.tmLanguage.json"
      },
      {
        "injectTo": [
          "source.mdx"
        ],
        "scopeName": "inline.mdx.script-style.injection",
        "path": "./syntaxes/mdx-script-style-injection.json",
        "embeddedLanguages": {
          "meta.embedded.block.css": "css",
          "meta.embedded.block.js": "javascript",
          "source.css": "css",
          "source.js": "javascript"
        }
      },
      {
        "injectTo": [
          "source.ts",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html",
        "path": "./syntaxes/lit-html.json",
        "embeddedLanguages": {
          "meta.embedded.block.html": "html",
          "meta.embedded.block.css": "css",
          "source.css": "css"
        }
      },
      {
        "injectTo": [
          "source.ts",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html.string.injection",
        "path": "./syntaxes/lit-html-string-injection.json",
        "embeddedLanguages": {
          "meta.template.expression.ts": "typescript"
        }
      },
      {
        "injectTo": [
          "source.ts",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html.interpolation.injection",
        "path": "./syntaxes/lit-html-interpolation-injection.json",
        "embeddedLanguages": {
          "meta.embedded.expression.ts": "typescript"
        }
      },
      {
        "injectTo": [
          "source.ts",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html.style.injection",
        "path": "./syntaxes/lit-html-style-injection.json",
        "embeddedLanguages": {
          "meta.template.expression.ts": "typescript"
        }
      },
      {
        "injectTo": [
          "source.ts",
          "text.html.basic"
        ],
        "scopeName": "inline.lit-html-svg",
        "path": "./syntaxes/lit-html-svg.json",
        "embeddedLanguages": {
          "meta.embedded.block.svg": "xml"
        }
      }
    ]
  }
}
