{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "..",
    "noEmit": true,
    "paths": {
      "@purestack/ts-format": ["../ts-format/src/index.ts"]
    },
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2020"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
