{
  "name": "@purestack/ts-common",
  "version": "1.1.5",
  "packageManager": "yarn@4.9.2",
  "module": "./dist/ts-common.mjs",
  "types": "./dist/ts-common.d.mts",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PureStackStudio/PureStack.git",
    "directory": "packages/ts-common"
  },
  "homepage": "https://purestack.studio",
  "bugs": {
    "url": "https://github.com/PureStackStudio/PureStack/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/ts-common.d.mts",
      "import": "./dist/ts-common.mjs"
    }
  },
  "dependencies": {
    "@purestack/ts-html": "workspace:^",
    "@purestack/ts-style": "workspace:^",
    "@purestack/ts-util": "workspace:^"
  },
  "license": "MIT",
  "files": [
    "dist/*.mjs",
    "dist/*.mjs.map",
    "dist/*.d.mts",
    "dist/*.d.mts.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "biome check ./src --formatter-enabled=false --write",
    "test": "vitest"
  }
}
