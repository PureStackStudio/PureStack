{
  "name": "purestack",
  "version": "1.1.24",
  "packageManager": "yarn@4.9.2",
  "module": "./dist/purestack.mjs",
  "types": "./dist/purestack.d.mts",
  "type": "module",
  "sideEffects": false,
  "bin": "./dist/cli.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PureStackStudio/PureStack.git",
    "directory": "packages/purestack"
  },
  "homepage": "https://purestack.studio",
  "bugs": {
    "url": "https://github.com/PureStackStudio/PureStack/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/purestack.d.mts",
      "import": "./dist/purestack.mjs"
    }
  },
  "license": "MIT",
  "files": [
    "dist/*.mjs",
    "dist/*.mjs.map",
    "dist/*.d.mts",
    "dist/*.d.mts.map",
    "forge/**/*",
    "skills/purestack-development/SKILL.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "biome check ./src --formatter-enabled=false --write",
    "test": "vitest",
    "prepack": "node -e \"const fs=require('node:fs');fs.mkdirSync('skills/purestack-development',{recursive:true});fs.copyFileSync('../../skills/purestack-development/SKILL.md','skills/purestack-development/SKILL.md')\"",
    "postpack": "node -e \"require('node:fs').rmSync('skills',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@purestack/ts-components": "workspace:^",
    "@purestack/ts-format": "workspace:^",
    "@purestack/ts-ssg": "workspace:^",
    "@purestack/ts-style": "workspace:^",
    "@purestack/ts-svg-icons": "workspace:^",
    "regor": "^1.7.6",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@purestack/ts-minidom": "workspace:^"
  }
}
