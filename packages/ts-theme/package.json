{
  "name": "@purestack/ts-theme",
  "version": "1.1.23",
  "packageManager": "yarn@4.9.2",
  "module": "./dist/ts-theme.mjs",
  "types": "./dist/ts-theme.d.mts",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PureStackStudio/PureStack.git",
    "directory": "packages/ts-theme"
  },
  "homepage": "https://purestack.studio",
  "bugs": {
    "url": "https://github.com/PureStackStudio/PureStack/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/ts-theme.d.mts",
      "import": "./dist/ts-theme.mjs"
    }
  },
  "license": "MIT",
  "files": [
    "dist/*.mjs",
    "dist/*.mjs.map",
    "dist/*.d.mts",
    "dist/*.d.mts.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "biome check ./src --formatter-enabled=false --write",
    "test": "vitest"
  },
  "dependencies": {
    "@purestack/ts-common": "workspace:^",
    "@purestack/ts-html": "workspace:^",
    "@purestack/ts-page-scripts": "workspace:^",
    "@purestack/ts-style": "workspace:^",
    "@purestack/ts-svg-icons": "workspace:^",
    "@purestack/ts-util-node": "workspace:^",
    "@types/hast": "^3.0.4",
    "highlight.js": "^11.11.1",
    "logpot": "^1.0.7"
  }
}
