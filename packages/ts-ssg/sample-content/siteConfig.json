{
  "$schema": "../schema/siteConfig.schema.json",
  "siteTitle": "ts-ssg",
  "logo": {
    "wordOne": "Calc",
    "wordTwo": "Core",
    "subtitle": "backend-native engine",
    "href": "/"
  },
  "styleFileName": "site.css",
  "styleHref": "/site.css",
  "styleThemes": ["light", "dark"],
  "navigation": {
    "mode": "auto",
    "navFileName": "_nav.json",
    "maxDepth": 20,
    "includeIndex": true,
    "sortBy": "order"
  },
  "sitemap": {
    "enabled": true,
    "baseUrl": "https://example.com",
    "fileName": "sitemap.xml",
    "robots": {
      "enabled": true,
      "fileName": "robots.txt",
      "userAgent": "*",
      "allow": ["/"],
      "disallow": ["/drafts/"],
      "crawlDelay": 2,
      "host": "example.com",
      "additionalSitemaps": ["https://example.com/news-sitemap.xml"],
      "customDirectives": ["# Generated by ts-ssg"]
    }
  },
  "outDir": "dist/site"
}
