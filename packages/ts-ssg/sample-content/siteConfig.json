{
  "$schema": "../schema/siteConfig.schema.json",
  "siteTitle": "ts-ssg",
  "favicon": "iconoir:cube",
  "logo": {
    "brand": "CalcCore",
    "subtitle": "backend-native engine",
    "icon": "iconoir:cube",
    "href": "/",
    "markStyle": "soft"
  },
  "style": {
    "fileName": "site.css",
    "href": "/assets/site.css",
    "themes": ["light", "dark"],
    "pretty": false,
    "theme": {
      "skin": "standard",
      "presets": ["red"]
    }
  },
  "html": {
    "minify": false
  },
  "scripts": {
    "cacheBusting": true
  },
  "navigation": {
    "mode": "auto",
    "navFileName": "_nav.json",
    "maxDepth": 20,
    "includeIndex": true,
    "sortBy": "order",
    "tone": "neutral"
  },
  "pageToc": {
    "tone": "neutral"
  },
  "auth": {
    "enabled": true
  },
  "sitemap": {
    "enabled": true,
    "baseUrl": "https://example.com",
    "fileName": "sitemap.xml",
    "robots": {
      "enabled": true,
      "fileName": "robots.txt",
      "userAgent": "*",
      "allow": ["/"],
      "disallow": ["/drafts/"],
      "crawlDelay": 2,
      "host": "example.com",
      "additionalSitemaps": ["https://example.com/news-sitemap.xml"],
      "customDirectives": ["# Generated by PureStack"]
    }
  },
  "consent": {
    "enabled": true,
    "policyVersion": "2023-02-17",
    "categories": [
      {
        "id": "necessary",
        "label": "Necessary",
        "required": true
      },
      {
        "id": "analytics",
        "label": "Analytics",
        "required": true
      }
    ],
    "services": []
  },
  "analytics": {
    "ga4": {
      "enabled": false,
      "measurementId": "G-TEST1234"
    }
  },
  "pagefind": {
    "enabled": true,
    "excludePaths": ["/privacy/", "/imprint/", "/terms/"]
  },
  "mdx": {
    "highlighter": "shiki"
  },
  "outDir": "../dist/site",
  "publishDir": "../dist/publish"
}
