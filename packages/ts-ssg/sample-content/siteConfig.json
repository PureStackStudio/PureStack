{
  "$schema": "../schema/siteConfig.schema.json",
  "siteTitle": "ts-ssg",
  "favicon": "iconoir:cube",
  "logo": {
    "brand": "CalcCore",
    "letterColors": "11112",
    "subtitleLetterColors": "0",
    "colors": [
      "var(--ps-current-text-subtle)",
      "var(--ps-current-text-default)",
      "var(--ps-semantic-tone-accent-button-rest-background)"
    ],
    "logoBackground": 2,
    "logoForeground": 1,
    "brandSize": "1.25rem",
    "brandSizeMd": "2rem",
    "brandSizeLg": "2.5rem",
    "subtitleSize": "0.5rem",
    "subtitleSizeMd": "0.8rem",
    "subtitleSizeLg": "1rem",
    "iconSize": "2rem",
    "iconSizeMd": "3.2rem",
    "iconSizeLg": "4rem",
    "subtitleInset": "1px",
    "subtitleInsetMd": "2px",
    "subtitle": "backend-native engine",
    "href": "/",
    "icon": "iconoir:cube"
  },
  "style": {
    "fileName": "site.css",
    "href": "/site.css",
    "themes": ["light", "dark"],
    "pretty": false,
    "theme": {
      "skin": "neon"
    }
  },
  "html": {
    "minify": false
  },
  "navigation": {
    "mode": "auto",
    "navFileName": "_nav.json",
    "maxDepth": 20,
    "includeIndex": true,
    "sortBy": "order",
    "tone": "neutral"
  },
  "pageToc": {
    "tone": "neutral"
  },
  "sitemap": {
    "enabled": true,
    "baseUrl": "https://example.com",
    "fileName": "sitemap.xml",
    "robots": {
      "enabled": true,
      "fileName": "robots.txt",
      "userAgent": "*",
      "allow": ["/"],
      "disallow": ["/drafts/"],
      "crawlDelay": 2,
      "host": "example.com",
      "additionalSitemaps": ["https://example.com/news-sitemap.xml"],
      "customDirectives": ["# Generated by ts-ssg"]
    }
  },
  "consent": {
    "enabled": true,
    "policyVersion": "2023-02-17",
    "categories": [
      {
        "id": "necessary",
        "label": "Necessary",
        "required": true
      },
      {
        "id": "analytics",
        "label": "Analytics",
        "required": true
      }
    ],
    "services": []
  },
  "analytics": {
    "ga4": {
      "enabled": false,
      "measurementId": "G-TEST1234"
    }
  },
  "pagefind": {
    "excludePaths": ["/privacy/", "/imprint/", "/terms/"]
  },
  "mdx": {
    "highlighter": "shiki"
  },
  "outDir": "../dist/site"
}
