{
  "$schema": "../schema/siteConfig.schema.json",
  "siteTitle": "ts-ssg",
  "logo": {
    "wordOne": "Calc",
    "wordTwo": "Core",
    "subtitle": "backend-native engine",
    "subtitleAlign": "center",
    "href": "/",
    "iconSvg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\\\"><path d=\"M16.4 8.2a6 6 0 1 0 0 7.6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"12\" cy=\"12\" r=\"2\" fill=\"currentColor\"/><path d=\"M14.6 9.6l1.2-1.2\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/><path d=\"M14.6 14.4l1.2 1.2\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>"
  },
  "styleFileName": "site.css",
  "styleHref": "/site.css",
  "styleThemes": ["light", "dark"],
  "navigation": {
    "mode": "auto",
    "navFileName": "_nav.json",
    "maxDepth": 20,
    "includeIndex": true,
    "sortBy": "order"
  },
  "sitemap": {
    "enabled": true,
    "baseUrl": "https://example.com",
    "fileName": "sitemap.xml",
    "robots": {
      "enabled": true,
      "fileName": "robots.txt",
      "userAgent": "*",
      "allow": ["/"],
      "disallow": ["/drafts/"],
      "crawlDelay": 2,
      "host": "example.com",
      "additionalSitemaps": ["https://example.com/news-sitemap.xml"],
      "customDirectives": ["# Generated by ts-ssg"]
    }
  },
  "consent": {
    "enabled": true,
    "policyVersion": "2023-02-16",
    "categories": [
      {
        "id": "necessary",
        "label": "Necessary",
        "required": true
      },
      {
        "id": "analytics",
        "label": "Analytics"
      }
    ],
    "services": []
  },
  "outDir": "dist/site"
}
