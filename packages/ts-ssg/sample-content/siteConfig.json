{
  "$schema": "../schema/siteConfig.schema.json",
  "siteTitle": "Waypoint",
  "favicon": "lucide:compass",
  "logo": {
    "brand": "Waypoint",
    "subtitle": "team workspace",
    "icon": "lucide:compass",
    "href": "/",
    "markStyle": "soft"
  },
  "style": {
    "fileName": "site.css",
    "href": "/assets/site.css",
    "themes": ["light", "dark"],
    "theme": {
      "skin": "standard",
      "presets": ["blue"]
    }
  },
  "scripts": {
    "cacheBusting": true
  },
  "navigation": {
    "mode": "auto",
    "maxDepth": 2,
    "includeIndex": true,
    "sortBy": "order",
    "tone": "neutral"
  },
  "pageToc": {
    "tone": "neutral"
  },
  "auth": {
    "enabled": false
  },
  "sitemap": {
    "enabled": false
  },
  "consent": {
    "enabled": false
  },
  "pagefind": {
    "enabled": true
  },
  "mdx": {
    "highlighter": "shiki"
  },
  "outDir": "../dist/site",
  "publishDir": "../dist/publish"
}
