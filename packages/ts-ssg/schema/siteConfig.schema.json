{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ts-ssg Site Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema file URL."
    },
    "siteTitle": {
      "type": "string",
      "description": "Default site title used by the head config when a page does not provide its own title.",
      "default": "ts-ssg"
    },
    "favicon": {
      "type": "string",
      "description": "SVG icon name from ts-svg-icons used to generate /assets/favicon.svg during the build."
    },
    "logo": {
      "type": "object",
      "description": "Brand logo configuration used by the top bar RegorLogo component.",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "type": "string",
          "description": "Brand string rendered as a single justified letter stream.",
          "default": "Pure Stack"
        },
        "letterColors": {
          "type": "string",
          "description": "Optional per-letter color index map. Each digit selects an entry from logo.colors and applies it to the next non-space letter."
        },
        "subtitleLetterColors": {
          "type": "string",
          "description": "Optional per-letter color index map for the subtitle. Each digit selects an entry from logo.colors and applies it to the next non-space letter."
        },
        "colors": {
          "type": "array",
          "description": "Palette of CSS color values used by logo.letterColors.",
          "items": {
            "type": "string"
          }
        },
        "logoBackground": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional index into logo.colors used for the logo glyph background. Keeps the built-in background when omitted."
        },
        "logoForeground": {
          "type": "integer",
          "minimum": 0,
          "description": "Optional index into logo.colors used for the logo icon and fallback mark foreground. Keeps the built-in foreground when omitted."
        },
        "brandSize": {
          "type": "string",
          "description": "Base brand font size."
        },
        "brandSizeSm": {
          "type": "string",
          "description": "Brand font size from the small breakpoint upward."
        },
        "brandSizeMd": {
          "type": "string",
          "description": "Brand font size from the medium breakpoint upward."
        },
        "brandSizeLg": {
          "type": "string",
          "description": "Brand font size from the large breakpoint upward."
        },
        "brandSizeXl": {
          "type": "string",
          "description": "Brand font size from the extra-large breakpoint upward."
        },
        "subtitleSize": {
          "type": "string",
          "description": "Base subtitle font size."
        },
        "subtitleSizeSm": {
          "type": "string",
          "description": "Subtitle font size from the small breakpoint upward."
        },
        "subtitleSizeMd": {
          "type": "string",
          "description": "Subtitle font size from the medium breakpoint upward."
        },
        "subtitleSizeLg": {
          "type": "string",
          "description": "Subtitle font size from the large breakpoint upward."
        },
        "subtitleSizeXl": {
          "type": "string",
          "description": "Subtitle font size from the extra-large breakpoint upward."
        },
        "iconSize": {
          "type": "string",
          "description": "Base logo glyph size."
        },
        "iconSizeSm": {
          "type": "string",
          "description": "Logo glyph size from the small breakpoint upward."
        },
        "iconSizeMd": {
          "type": "string",
          "description": "Logo glyph size from the medium breakpoint upward."
        },
        "iconSizeLg": {
          "type": "string",
          "description": "Logo glyph size from the large breakpoint upward."
        },
        "iconSizeXl": {
          "type": "string",
          "description": "Logo glyph size from the extra-large breakpoint upward."
        },
        "subtitleInset": {
          "type": "string",
          "description": "Base left and right inset applied to the subtitle row."
        },
        "subtitleInsetSm": {
          "type": "string",
          "description": "Subtitle inset from the small breakpoint upward."
        },
        "subtitleInsetMd": {
          "type": "string",
          "description": "Subtitle inset from the medium breakpoint upward."
        },
        "subtitleInsetLg": {
          "type": "string",
          "description": "Subtitle inset from the large breakpoint upward."
        },
        "subtitleInsetXl": {
          "type": "string",
          "description": "Subtitle inset from the extra-large breakpoint upward."
        },
        "subtitle": {
          "type": "string",
          "description": "Optional subtitle text shown below the brand name."
        },
        "href": {
          "type": "string",
          "description": "Logo link target.",
          "default": "/"
        },
        "icon": {
          "type": "string",
          "description": "SVG icon name from ts-svg-icons used in the logo component."
        }
      }
    },
    "style": {
      "type": "object",
      "description": "Stylesheet generation and theme settings.",
      "additionalProperties": false,
      "properties": {
        "fileName": {
          "type": "string",
          "description": "CSS file name written to the output directory.",
          "default": "site.css"
        },
        "href": {
          "type": "string",
          "description": "Public href injected into rendered pages for the site stylesheet.",
          "default": "/assets/site.css"
        },
        "themes": {
          "type": "array",
          "description": "Theme names to emit as stylesheets. Must include light and dark.",
          "items": {
            "type": "string"
          },
          "default": ["light", "dark"]
        },
        "pretty": {
          "type": "boolean",
          "description": "When true, format generated CSS with Prettier.",
          "default": false
        },
        "theme": {
          "type": "object",
          "description": "Theme customization options.",
          "additionalProperties": true,
          "properties": {
            "skin": {
              "type": "string",
              "enum": [
                "ocean",
                "evergreen",
                "pastel",
                "extrao",
                "cyberpunk",
                "neon"
              ],
              "description": "Built-in skin preset. Applies both light and dark palettes before any explicit theme token overrides."
            }
          }
        }
      }
    },
    "html": {
      "type": "object",
      "description": "HTML output settings.",
      "additionalProperties": false,
      "properties": {
        "minify": {
          "type": "boolean",
          "description": "Minify generated HTML output files.",
          "default": false
        }
      }
    },
    "navigation": {
      "type": "object",
      "description": "Navigation menu configuration for auto/custom/hybrid menus.",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["auto", "custom", "hybrid", "none"],
          "description": "Menu generation mode.",
          "default": "auto"
        },
        "navFileName": {
          "type": "string",
          "description": "Filename used for custom navigation definitions.",
          "default": "_nav.json"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum folder depth for nested navigation.",
          "default": 1
        },
        "includeIndex": {
          "type": "boolean",
          "description": "Whether index pages appear in auto navigation.",
          "default": true
        },
        "sortBy": {
          "type": "string",
          "enum": ["order", "title", "path"],
          "description": "Sorting strategy for navigation items.",
          "default": "order"
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "accent",
            "info",
            "success",
            "warning",
            "danger",
            "ghost"
          ],
          "description": "Navigation menu semantic tone.",
          "default": "neutral"
        }
      }
    },
    "pageToc": {
      "type": "object",
      "description": "Page table-of-contents component configuration.",
      "additionalProperties": false,
      "properties": {
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "accent",
            "info",
            "success",
            "warning",
            "danger",
            "ghost"
          ],
          "description": "Page table-of-contents semantic tone.",
          "default": "neutral"
        }
      }
    },
    "auth": {
      "type": "object",
      "description": "Site-wide authentication UI policy.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether built-in sign-in/account controls render across the site.",
          "default": false
        },
        "signUp": {
          "type": "boolean",
          "description": "Whether the built-in sign-up action is shown when auth is enabled.",
          "default": true
        },
        "signedInStorageKey": {
          "type": "string",
          "description": "localStorage key used for the critical weak signed-in UI hint.",
          "default": "signed-in-hint"
        }
      }
    },
    "scripts": {
      "type": "object",
      "description": "Script asset output settings.",
      "additionalProperties": false,
      "properties": {
        "cacheBusting": {
          "type": "boolean",
          "description": "When true, emitted local TypeScript script filenames include a build cache key so browsers fetch fresh bundles after rebuilds.",
          "default": true
        }
      }
    },
    "sitemap": {
      "type": "object",
      "description": "Sitemap generation settings.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether sitemap.xml is emitted during builds.",
          "default": false
        },
        "baseUrl": {
          "type": "string",
          "description": "Absolute public base URL used to build full sitemap URLs.",
          "default": ""
        },
        "fileName": {
          "type": "string",
          "description": "Output filename for the sitemap file.",
          "default": "sitemap.xml"
        },
        "robots": {
          "type": "object",
          "description": "robots.txt generation settings.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether robots.txt is emitted when sitemap is enabled.",
              "default": true
            },
            "fileName": {
              "type": "string",
              "description": "Output filename for robots.txt.",
              "default": "robots.txt"
            },
            "userAgent": {
              "type": "string",
              "description": "User-agent token for directives.",
              "default": "*"
            },
            "allow": {
              "type": "array",
              "description": "Allowed path prefixes.",
              "items": { "type": "string" },
              "default": ["/"]
            },
            "disallow": {
              "type": "array",
              "description": "Disallowed path prefixes.",
              "items": { "type": "string" },
              "default": []
            },
            "crawlDelay": {
              "type": "number",
              "minimum": 0,
              "description": "Optional crawl-delay directive."
            },
            "host": {
              "type": "string",
              "description": "Optional host directive."
            },
            "additionalSitemaps": {
              "type": "array",
              "description": "Additional absolute sitemap URLs.",
              "items": { "type": "string" },
              "default": []
            },
            "customDirectives": {
              "type": "array",
              "description": "Raw extra robots.txt lines appended at the end.",
              "items": { "type": "string" },
              "default": []
            }
          }
        }
      }
    },
    "consent": {
      "type": "object",
      "description": "Consent manager settings for optional scripts and cookies.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enables consent runtime and script gating.",
          "default": false
        },
        "storageKey": {
          "type": "string",
          "description": "localStorage key used to persist consent state.",
          "default": "ts-ssg-consent"
        },
        "policyVersion": {
          "type": "string",
          "description": "Version string used to invalidate old consent after policy changes.",
          "default": "1"
        },
        "bannerTitle": {
          "type": "string",
          "description": "Consent banner heading.",
          "default": "Your privacy choices"
        },
        "bannerDescription": {
          "type": "string",
          "description": "Consent banner description text.",
          "default": "We use cookies and similar technologies to improve your experience. You can accept all, reject non-essential, or manage preferences."
        },
        "privacyPolicyUrl": {
          "type": "string",
          "description": "Optional link target for privacy policy."
        },
        "privacyPolicyLabel": {
          "type": "string",
          "description": "Label for the privacy policy link.",
          "default": "Privacy Policy"
        },
        "acceptAllLabel": {
          "type": "string",
          "description": "Label for the accept-all action.",
          "default": "Accept all"
        },
        "rejectAllLabel": {
          "type": "string",
          "description": "Label for the reject-non-essential action.",
          "default": "Reject non-essential"
        },
        "manageLabel": {
          "type": "string",
          "description": "Label for the manage-preferences action.",
          "default": "Manage preferences"
        },
        "saveLabel": {
          "type": "string",
          "description": "Label for save-preferences action in settings dialog.",
          "default": "Save choices"
        },
        "settingsLabel": {
          "type": "string",
          "description": "Label for always-available privacy settings trigger.",
          "default": "Privacy settings"
        },
        "categories": {
          "type": "array",
          "description": "Consent categories. Include at least one required category (usually necessary).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable category identifier."
              },
              "label": {
                "type": "string",
                "description": "User-facing category label."
              },
              "description": {
                "type": "string",
                "description": "Optional category description."
              },
              "required": {
                "type": "boolean",
                "description": "Marks category as always enabled and non-toggleable."
              }
            },
            "required": ["id"]
          }
        },
        "services": {
          "type": "array",
          "description": "Services that are loaded only when their consent category is granted.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable service identifier."
              },
              "category": {
                "type": "string",
                "description": "Category id controlling this service."
              },
              "label": {
                "type": "string",
                "description": "User-facing service label."
              },
              "description": {
                "type": "string",
                "description": "Optional service description."
              },
              "scripts": {
                "type": "array",
                "description": "Script descriptors for this service.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "src": {
                      "type": "string",
                      "description": "External script URL."
                    },
                    "content": {
                      "type": "string",
                      "description": "Inline script source."
                    },
                    "type": {
                      "type": "string",
                      "description": "Script type attribute (for example module)."
                    },
                    "async": {
                      "type": "boolean",
                      "description": "Adds async attribute for external scripts."
                    },
                    "defer": {
                      "type": "boolean",
                      "description": "Adds defer attribute for external scripts."
                    },
                    "integrity": {
                      "type": "string",
                      "description": "Subresource integrity attribute."
                    },
                    "nonce": {
                      "type": "string",
                      "description": "Nonce attribute for CSP."
                    },
                    "crossOrigin": {
                      "type": "string",
                      "enum": ["anonymous", "use-credentials"],
                      "description": "crossorigin attribute for external scripts."
                    },
                    "referrerPolicy": {
                      "type": "string",
                      "description": "referrerpolicy attribute for external scripts."
                    }
                  }
                }
              }
            },
            "required": ["id", "category", "scripts"]
          }
        }
      }
    },
    "analytics": {
      "type": "object",
      "description": "Analytics integrations.",
      "additionalProperties": false,
      "properties": {
        "ga4": {
          "type": "object",
          "description": "Google Analytics 4 integration settings.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enables GA4. Defaults to true when measurementId is set.",
              "default": false
            },
            "measurementId": {
              "type": "string",
              "description": "GA4 measurement id like G-XXXXXXXX."
            },
            "serviceId": {
              "type": "string",
              "description": "Consent service id used when consent manager is enabled.",
              "default": "ga4"
            },
            "consentCategory": {
              "type": "string",
              "description": "Consent category id required before GA4 scripts load.",
              "default": "analytics"
            }
          }
        }
      }
    },
    "pagefind": {
      "type": "object",
      "description": "Pagefind indexing settings.",
      "additionalProperties": false,
      "properties": {
        "excludePaths": {
          "type": "array",
          "description": "Route prefixes to exclude from search indexing (for example /privacy/).",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "mdx": {
      "type": "object",
      "description": "Markdown/MDX compiler settings.",
      "additionalProperties": false,
      "properties": {
        "highlighter": {
          "type": "string",
          "enum": ["shiki", "highlightjs"],
          "description": "Syntax highlighter backend. Use highlightjs for faster builds.",
          "default": "highlightjs"
        },
        "disableHighlighter": {
          "type": "boolean",
          "description": "Disable syntax highlighting entirely.",
          "default": false
        }
      }
    },
    "outDir": {
      "type": "string",
      "description": "Development output directory path. Relative paths are resolved from the content directory (siteConfig location).",
      "default": "dist/site"
    },
    "publishDir": {
      "type": "string",
      "description": "Publish output directory path used by publish builds. Relative paths are resolved from the content directory (siteConfig location).",
      "default": "dist/publish"
    }
  }
}
