{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ts-ssg Site Config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema file URL."
    },
    "siteTitle": {
      "type": "string",
      "description": "Default site title used by the head config when a page does not provide its own title.",
      "default": "ts-ssg"
    },
    "basePath": {
      "type": "string",
      "description": "Optional public mount path for generated URLs, for example /docs or /admin-panel. Output files remain rooted at outDir.",
      "default": ""
    },
    "favicon": {
      "type": "string",
      "description": "SVG icon name from ts-svg-icons used to generate /assets/favicon.svg during the build."
    },
    "logo": {
      "type": "object",
      "description": "Shared SiteLogo options used by the documentation header.",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "type": "string",
          "description": "Brand name, rendered as ordinary text.",
          "default": "Pure Stack"
        },
        "href": {
          "type": [
            "string",
            "null"
          ],
          "description": "Link destination. Null or an empty string renders a noninteractive logo.",
          "default": "/"
        },
        "subtitle": {
          "type": "string",
          "description": "Secondary line beneath the wordmark."
        },
        "suffix": {
          "type": "string",
          "description": "Accented text appended to the brand, for example a period."
        },
        "ariaLabel": {
          "type": "string",
          "description": "Accessible name. Defaults to the brand."
        },
        "icon": {
          "type": "string",
          "description": "Registered SVG icon name."
        },
        "imageSrc": {
          "type": "string",
          "description": "Image used as the logo mark; takes priority over icon."
        },
        "imageSrcDark": {
          "type": "string",
          "description": "Optional image shown in dark mode; requires imageSrc."
        },
        "monogram": {
          "type": "string",
          "description": "Fallback mark text when no image or icon is provided."
        },
        "brandColor": {
          "type": "string",
          "description": "Wordmark CSS color or theme variable."
        },
        "accentColor": {
          "type": "string",
          "description": "Accent CSS color for the suffix, plain mark and gradient."
        },
        "markBackground": {
          "type": "string",
          "description": "Mark background CSS color or gradient."
        },
        "markColor": {
          "type": "string",
          "description": "Mark foreground CSS color."
        },
        "brandSize": {
          "type": "string",
          "description": "Custom wordmark CSS font size; supports clamp()."
        },
        "subtitleSize": {
          "type": "string",
          "description": "Custom subtitle CSS font size."
        },
        "markSize": {
          "type": "string",
          "description": "Custom mark CSS width and height."
        },
        "gap": {
          "type": "string",
          "description": "CSS gap between the mark and wordmark."
        },
        "layout": {
          "type": "string",
          "enum": [
            "horizontal",
            "stacked",
            "wordmark",
            "mark"
          ],
          "default": "horizontal"
        },
        "size": {
          "type": "string",
          "enum": [
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "default": "md"
        },
        "appearance": {
          "type": "string",
          "enum": [
            "plain",
            "badge",
            "outline"
          ],
          "default": "plain"
        },
        "markStyle": {
          "type": "string",
          "enum": [
            "plain",
            "soft",
            "solid",
            "outline"
          ],
          "default": "plain"
        },
        "wordmarkStyle": {
          "type": "string",
          "enum": [
            "plain",
            "accent",
            "gradient"
          ],
          "default": "plain"
        },
        "shape": {
          "type": "string",
          "enum": [
            "rounded",
            "square",
            "circle"
          ],
          "default": "rounded"
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "accent",
            "secondary",
            "info",
            "success",
            "warning",
            "danger",
            "feature",
            "custom",
            "ghost"
          ],
          "default": "accent"
        }
      }
    },
    "style": {
      "type": "object",
      "description": "Stylesheet generation and theme settings.",
      "additionalProperties": false,
      "properties": {
        "fileName": {
          "type": "string",
          "description": "CSS file name written to the output directory.",
          "default": "site.css"
        },
        "href": {
          "type": "string",
          "description": "Public href injected into rendered pages for the site stylesheet.",
          "default": "/assets/site.css"
        },
        "themes": {
          "type": "array",
          "description": "Theme names to emit as stylesheets. Must include light and dark.",
          "items": {
            "type": "string"
          },
          "default": [
            "light",
            "dark"
          ]
        },
        "pretty": {
          "type": "boolean",
          "description": "When true, format generated CSS with Prettier.",
          "default": false
        },
        "theme": {
          "type": "object",
          "description": "Theme customization options.",
          "additionalProperties": true,
          "properties": {
            "skin": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "standard"
                  ]
                },
                {
                  "type": "string"
                }
              ],
              "description": "Registered theme skin name. Applies both light and dark palettes before any explicit theme token overrides."
            },
            "presets": {
              "type": "array",
              "description": "Ordered skin preset names. Presets are interpreted by the selected skin.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "remSize": {
              "type": "string",
              "description": "Optional root font-size applied globally. Leave empty to keep the browser/default root size.",
              "default": ""
            },
            "mobileRemSize": {
              "type": "string",
              "description": "Optional root font-size applied below the medium breakpoint. Leave empty to keep the browser/default root size.",
              "default": ""
            }
          }
        }
      }
    },
    "html": {
      "type": "object",
      "description": "HTML output settings.",
      "additionalProperties": false,
      "properties": {
        "minify": {
          "type": "boolean",
          "description": "Minify generated HTML output files.",
          "default": false
        }
      }
    },
    "navigation": {
      "type": "object",
      "description": "Navigation menu configuration for auto/custom/hybrid menus.",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "custom",
            "hybrid",
            "none"
          ],
          "description": "Menu generation mode.",
          "default": "auto"
        },
        "navFileName": {
          "type": "string",
          "description": "Filename used for custom navigation definitions.",
          "default": "_nav.json"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum folder depth for nested navigation.",
          "default": 1
        },
        "includeIndex": {
          "type": "boolean",
          "description": "Whether index pages appear in auto navigation.",
          "default": true
        },
        "sortBy": {
          "type": "string",
          "enum": [
            "order",
            "title",
            "path"
          ],
          "description": "Sorting strategy for navigation items.",
          "default": "order"
        },
        "roots": {
          "type": "array",
          "description": "Folder paths that act as navigation roots for their descendant pages.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "accent",
            "info",
            "success",
            "warning",
            "danger",
            "ghost"
          ],
          "description": "Navigation menu semantic tone.",
          "default": "neutral"
        }
      }
    },
    "pageToc": {
      "type": "object",
      "description": "Page table-of-contents component configuration.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Default table-of-contents behavior for pages. Individual pages can override it with frontmatter layout.showToc.",
          "default": true
        },
        "tone": {
          "type": "string",
          "enum": [
            "neutral",
            "accent",
            "info",
            "success",
            "warning",
            "danger",
            "ghost"
          ],
          "description": "Page table-of-contents semantic tone.",
          "default": "neutral"
        }
      }
    },
    "auth": {
      "type": "object",
      "description": "Site-wide authentication UI policy.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether built-in sign-in/account controls render across the site.",
          "default": false
        },
        "signUp": {
          "type": "boolean",
          "description": "Whether the built-in sign-up action is shown when auth is enabled.",
          "default": true
        },
        "signedInStorageKey": {
          "type": "string",
          "description": "localStorage key used for the critical weak signed-in UI hint.",
          "default": "signed-in-hint"
        }
      }
    },
    "scripts": {
      "type": "object",
      "description": "Script asset output settings.",
      "additionalProperties": false,
      "properties": {
        "cacheBusting": {
          "type": "boolean",
          "description": "When true, emitted local TypeScript script filenames include a build cache key so browsers fetch fresh bundles after rebuilds.",
          "default": true
        }
      }
    },
    "sitemap": {
      "type": "object",
      "description": "Sitemap generation settings.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether sitemap.xml is emitted during builds.",
          "default": false
        },
        "baseUrl": {
          "type": "string",
          "description": "Absolute public base URL used to build full sitemap URLs.",
          "default": ""
        },
        "fileName": {
          "type": "string",
          "description": "Output filename for the sitemap file.",
          "default": "sitemap.xml"
        },
        "robots": {
          "type": "object",
          "description": "robots.txt generation settings.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Whether robots.txt is emitted when sitemap is enabled.",
              "default": true
            },
            "fileName": {
              "type": "string",
              "description": "Output filename for robots.txt.",
              "default": "robots.txt"
            },
            "userAgent": {
              "type": "string",
              "description": "User-agent token for directives.",
              "default": "*"
            },
            "allow": {
              "type": "array",
              "description": "Allowed path prefixes.",
              "items": {
                "type": "string"
              },
              "default": [
                "/"
              ]
            },
            "disallow": {
              "type": "array",
              "description": "Disallowed path prefixes.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "crawlDelay": {
              "type": "number",
              "minimum": 0,
              "description": "Optional crawl-delay directive."
            },
            "host": {
              "type": "string",
              "description": "Optional host directive."
            },
            "additionalSitemaps": {
              "type": "array",
              "description": "Additional absolute sitemap URLs.",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "customDirectives": {
              "type": "array",
              "description": "Raw extra robots.txt lines appended at the end.",
              "items": {
                "type": "string"
              },
              "default": []
            }
          }
        }
      }
    },
    "consent": {
      "type": "object",
      "description": "Consent manager settings for optional scripts and cookies.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enables consent runtime and script gating.",
          "default": false
        },
        "storageKey": {
          "type": "string",
          "description": "localStorage key used to persist consent state.",
          "default": "ts-ssg-consent"
        },
        "policyVersion": {
          "type": "string",
          "description": "Version string used to invalidate old consent after policy changes.",
          "default": "1"
        },
        "bannerTitle": {
          "type": "string",
          "description": "Consent banner heading.",
          "default": "Your privacy choices"
        },
        "bannerDescription": {
          "type": "string",
          "description": "Consent banner description text.",
          "default": "We use cookies and similar technologies to improve your experience. You can accept all, reject non-essential, or manage preferences."
        },
        "privacyPolicyUrl": {
          "type": "string",
          "description": "Optional link target for privacy policy."
        },
        "privacyPolicyLabel": {
          "type": "string",
          "description": "Label for the privacy policy link.",
          "default": "Privacy Policy"
        },
        "acceptAllLabel": {
          "type": "string",
          "description": "Label for the accept-all action.",
          "default": "Accept all"
        },
        "rejectAllLabel": {
          "type": "string",
          "description": "Label for the reject-non-essential action.",
          "default": "Reject non-essential"
        },
        "manageLabel": {
          "type": "string",
          "description": "Label for the manage-preferences action.",
          "default": "Manage preferences"
        },
        "saveLabel": {
          "type": "string",
          "description": "Label for save-preferences action in settings dialog.",
          "default": "Save choices"
        },
        "settingsLabel": {
          "type": "string",
          "description": "Label for always-available privacy settings trigger.",
          "default": "Privacy settings"
        },
        "categories": {
          "type": "array",
          "description": "Consent categories. Include at least one required category (usually necessary).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable category identifier."
              },
              "label": {
                "type": "string",
                "description": "User-facing category label."
              },
              "description": {
                "type": "string",
                "description": "Optional category description."
              },
              "required": {
                "type": "boolean",
                "description": "Marks category as always enabled and non-toggleable."
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "services": {
          "type": "array",
          "description": "Services that are loaded only when their consent category is granted.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable service identifier."
              },
              "category": {
                "type": "string",
                "description": "Category id controlling this service."
              },
              "label": {
                "type": "string",
                "description": "User-facing service label."
              },
              "description": {
                "type": "string",
                "description": "Optional service description."
              },
              "scripts": {
                "type": "array",
                "description": "Script descriptors for this service.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "src": {
                      "type": "string",
                      "description": "External script URL."
                    },
                    "content": {
                      "type": "string",
                      "description": "Inline script source."
                    },
                    "type": {
                      "type": "string",
                      "description": "Script type attribute (for example module)."
                    },
                    "async": {
                      "type": "boolean",
                      "description": "Adds async attribute for external scripts."
                    },
                    "defer": {
                      "type": "boolean",
                      "description": "Adds defer attribute for external scripts."
                    },
                    "integrity": {
                      "type": "string",
                      "description": "Subresource integrity attribute."
                    },
                    "nonce": {
                      "type": "string",
                      "description": "Nonce attribute for CSP."
                    },
                    "crossOrigin": {
                      "type": "string",
                      "enum": [
                        "anonymous",
                        "use-credentials"
                      ],
                      "description": "crossorigin attribute for external scripts."
                    },
                    "referrerPolicy": {
                      "type": "string",
                      "description": "referrerpolicy attribute for external scripts."
                    }
                  }
                }
              }
            },
            "required": [
              "id",
              "category",
              "scripts"
            ]
          }
        }
      }
    },
    "analytics": {
      "type": "object",
      "description": "Analytics integrations.",
      "additionalProperties": false,
      "properties": {
        "ga4": {
          "type": "object",
          "description": "Google Analytics 4 integration settings.",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enables GA4. Defaults to true when measurementId is set.",
              "default": false
            },
            "measurementId": {
              "type": "string",
              "description": "GA4 measurement id like G-XXXXXXXX."
            },
            "serviceId": {
              "type": "string",
              "description": "Consent service id used when consent manager is enabled.",
              "default": "ga4"
            },
            "consentCategory": {
              "type": "string",
              "description": "Consent category id required before GA4 scripts load.",
              "default": "analytics"
            }
          }
        }
      }
    },
    "pagefind": {
      "type": "object",
      "description": "Pagefind indexing settings.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether Pagefind search indexing and the built-in search runtime are enabled.",
          "default": true
        },
        "excludePaths": {
          "type": "array",
          "description": "Route prefixes to exclude from search indexing (for example /privacy/).",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "preview": {
      "type": "object",
      "description": "Site-level social/search preview defaults used to generate canonical, Open Graph, and Twitter Card metadata.",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "Default title for social preview cards."
        },
        "description": {
          "type": "string",
          "description": "Default description for social preview cards."
        },
        "image": {
          "type": "string",
          "description": "Default preview image URL or site-root-relative path."
        },
        "imageAlt": {
          "type": "string",
          "description": "Alt text for the default preview image."
        },
        "imageWidth": {
          "type": "integer",
          "minimum": 1,
          "description": "Width of the default preview image in pixels."
        },
        "imageHeight": {
          "type": "integer",
          "minimum": 1,
          "description": "Height of the default preview image in pixels."
        },
        "siteName": {
          "type": "string",
          "description": "Open Graph site name. Defaults to siteTitle when omitted."
        },
        "type": {
          "type": "string",
          "description": "Open Graph type, for example website or article.",
          "default": "website"
        },
        "locale": {
          "type": "string",
          "description": "Open Graph locale, for example en_US."
        },
        "twitterCard": {
          "type": "string",
          "description": "Twitter Card type, for example summary or summary_large_image."
        },
        "twitterSite": {
          "type": "string",
          "description": "Twitter/X site handle."
        },
        "twitterCreator": {
          "type": "string",
          "description": "Twitter/X creator handle."
        }
      }
    },
    "i18n": {
      "type": "object",
      "description": "Optional multilingual site configuration. When omitted, the site behaves as a single-language site.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enables locale-aware content discovery and routing.",
          "default": false
        },
        "defaultLocale": {
          "type": "string",
          "description": "Default locale, for example en or de."
        },
        "locales": {
          "type": "array",
          "description": "Supported locale folder names.",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "urlStrategy": {
          "type": "string",
          "enum": [
            "prefix-all",
            "hidden"
          ],
          "description": "Public URL strategy. prefix-all emits /en/... and /de/.... hidden keeps canonical URLs unprefixed while writing locale folders for host/server negotiation.",
          "default": "prefix-all"
        },
        "queryParam": {
          "type": "string",
          "description": "Language query parameter used by hidden-strategy hosts/dev server.",
          "default": "lang"
        },
        "cookieName": {
          "type": "string",
          "description": "Language preference cookie name used by hidden-strategy hosts/dev server.",
          "default": "ts-ssg.lang"
        }
      }
    },
    "mdx": {
      "type": "object",
      "description": "Markdown/MDX compiler settings.",
      "additionalProperties": false,
      "properties": {
        "highlighter": {
          "type": "string",
          "enum": [
            "shiki",
            "highlightjs"
          ],
          "description": "Syntax highlighter backend. Use highlightjs for faster builds.",
          "default": "highlightjs"
        },
        "disableHighlighter": {
          "type": "boolean",
          "description": "Disable syntax highlighting entirely.",
          "default": false
        },
        "compileMdAsMdx": {
          "type": "boolean",
          "description": "Compile .md content files with the MDX/Regor markup pipeline.",
          "default": true
        }
      }
    },
    "outDir": {
      "type": "string",
      "description": "Development output directory path. Relative paths are resolved from the content directory (siteConfig location).",
      "default": "dist/site"
    },
    "publishDir": {
      "type": "string",
      "description": "Publish output directory path used by publish builds. Relative paths are resolved from the content directory (siteConfig location).",
      "default": "dist/publish"
    }
  }
}
