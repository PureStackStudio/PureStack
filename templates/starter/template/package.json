{
  "name": "purestack-starter",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "purestack serve --content ./content --port 5000",
    "build": "purestack build --content ./content",
    "publish": "purestack publish --content ./content",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write . && yarn format:markup --write",
    "format:markup": "purestack format .",
    "format:check": "biome format . && yarn format:markup --check",
    "check": "biome check . && yarn format:markup --check",
    "check:fix": "biome check --write . && yarn format:markup --write"
  },
  "dependencies": {
    "purestack": "latest",
    "@purestack/ts-components": "latest",
    "@purestack/ts-style": "latest",
    "regor": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@biomejs/biome": "^2.6.2",
    "@purestack/ts-minidom": "latest",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
